# 复制为 .env 后按需填写。以下为虚构占位，勿提交真实密钥。

ASYNC_DATABASE_URL=postgresql://user:changeme@db.example.com:5432/appdb
DEBUG=true
JWT_SECRET=请替换为足够长的随机串

# 日志（生产建议 LOG_FORMAT=json；容器默认只写 stderr，用 docker logs 查看）
LOG_LEVEL=INFO
LOG_FORMAT=text
# 可选：宿主机落盘（需目录可写；Docker 示例见 README「日志落盘与轮转」）
# LOG_FILE=/var/log/my-agent-server/app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# Redis
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# 运维探活：未设置或留空时 GET /server-status 始终 404
SERVER_STATUS_TOKEN=
# 逗号分隔的前端 Origin；留空则不启用 CORS 中间件
CORS_ORIGINS=
# 限流等是否信任 X-Forwarded-For（仅当受信反向代理会正确改写该头时设为 true）
TRUST_PROXY_HEADERS=false

# LangChain Agent（Google GenAI）
AGENT_CHAT_API_KEY=your-google-api-key
# 可选：模型标识，默认见 core.settings
# AGENT_CHAT_MODEL=google_genai:gemini-2.5-flash
# AGENT_SSE_TIMEOUT_SECONDS=120
# AGENT_GET_MSG_MAX_CHARS=2000
# AGENT_BODY_MAX_CHARS=32000

# RAG（需 PostgreSQL 启用 pgvector，见 migrations/001_pgvector.sql）
# 火山方舟 API Key：https://console.volcengine.com/ark/region:ark+cn-beijing/apikey
ARK_API_KEY=your-ark-api-key
# 方舟根路径（勿加 /embeddings、/process）
# RAG_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Doubao-embedding-vision 推理接入点 ID，如 ep-xxx
# RAG_EMBEDDING_MODEL=ep-your-vision-endpoint
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_EMBEDDING_MAX_CONCURRENCY=8
# RAG_CHUNK_SIZE=1000
# RAG_CHUNK_OVERLAP=200
# RAG_TOP_K=4
# RAG_SEARCH_TYPE=similarity
# RAG_MMR_FETCH_K=20
# RAG_MMR_LAMBDA_MULT=0.5
# RAG_MAX_UPLOAD_BYTES=52428800
# RAG_UPLOAD_DIR=./data/uploads
# RAG_INGEST_QUEUE_KEY=rag:ingest:queue
# RAG_INGEST_BATCH_SIZE=32
# RAG_INGEST_MAX_PARALLEL=1
# RAG_INGEST_BATCH_TIMEOUT_SECONDS=120
# RAG_INGEST_TIMEOUT_SECONDS=300
# RAG_RETRIEVE_TIMEOUT_SECONDS=60
# RAG_VECTOR_COLLECTION=wensu_chunks
