# 复制为 .env 后按需填写。以下为虚构占位，勿提交真实密钥。

ASYNC_DATABASE_URL=postgresql://user:changeme@db.example.com:5432/appdb
DEBUG=true
JWT_SECRET=请替换为足够长的随机串

# 日志
LOG_LEVEL=INFO
LOG_FORMAT=text

# Redis
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changeme

# 运维探活：未设置或留空时 GET /server-status 始终 404
SERVER_STATUS_TOKEN=
# 逗号分隔的前端 Origin；留空则不启用 CORS 中间件
CORS_ORIGINS=
# 限流等是否信任 X-Forwarded-For（仅当受信反向代理会正确改写该头时设为 true）
TRUST_PROXY_HEADERS=false

# LangChain Agent（Google GenAI）
GOOGLE_API_KEY=your-google-api-key
# 可选：模型标识，默认见 core.settings
# AGENT_CHAT_MODEL=google_genai:gemini-2.5-flash
# AGENT_SSE_TIMEOUT_SECONDS=120
# AGENT_GET_MSG_MAX_CHARS=2000
# AGENT_BODY_MAX_CHARS=32000
